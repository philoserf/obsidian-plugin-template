{
  "name": "obsidian-plugin-template",
  "version": "1.0.0",
  "description": "A minimal template for Obsidian plugins using Bun",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "bun run build.ts --watch",
    "build": "bun run check && bun run build.ts",
    "check": "bun run typecheck && bun run lint && bun run format:check",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "version": "bun run version-bump.ts",
    "test": "bun test"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "template"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "^2.4.3",
    "@types/bun": "^1.3.9",
    "@types/node": "25.3.0",
    "obsidian": "1.12.2",
    "typescript": "5.9.3"
  }
}
